# Config chứa secret (API key, token) – không commit
config.env
.env
.env.*
!.env.example

# Cookies (có thể chứa secret trình duyệt / Canva)
cookies.txt

# Google Cloud / service account credentials (never commit)
gen-lang-client-*.json
*-credentials*.json

# Log đối thoại AI (huấn luyện) – tùy chọn commit
logs/

venv/

# File tải về (video TikTok, ảnh tạm) — không commit, tránh vượt giới hạn GitHub 100MB
downloads/
*.part

# Runtime logs / error dumps / local caches
DoraLogs.txt
DoraLogs.txt.*
unknown_errors.txt
cache/

# Telegram / Pyrogram session files (local bot start leftovers)
*.session
*.session-journal

# Python cache/build artifacts
__pycache__/
*.py[cod]
*$py.class

# OS/editor artifacts
.DS_Store
.antigravitycli/
